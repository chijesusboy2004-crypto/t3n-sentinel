# ====================================================================
# T3N Sentinel - Environment Configuration
# ====================================================================

# T3N Network Environment (testnet | sandbox | production)
T3N_ENV=testnet

# T3N Tenant Developer API Key (from https://go.terminal3.io/adk-community)
# Used for contract and namespace administration
T3N_API_KEY=

# Dedicated Agent Key (from claim page or generated secp256k1 key)
# IMPORTANT: Agents MUST use a separate key with its own test credits.
AGENT_KEY=

# Runtime Mode:
# 'auto'        - Attempts live T3N testnet; falls back gracefully to simulation if offline
# 'live'        - Enforces live T3N connection (fails if testnet unreachable)
# 'simulation'  - Runs offline high-fidelity TEE enclave simulation (instant, 100% reliable)
SENTINEL_MODE=auto

# Operational Credit Alert Threshold (alerts when agent credits dip below this value)
CREDIT_ALERT_THRESHOLD=1000

# Compliance & Policy Engine Configuration
MAX_SINGLE_TRANSACTION_LIMIT=10000
DUPLICATE_WINDOW_HOURS=48
AUTHORIZED_EGRESS_HOSTS=api.compliance-matrix.internal,api.treasury-feed.internal
